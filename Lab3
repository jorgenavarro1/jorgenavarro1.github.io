// Exercise #1 - minMaxAverage
function minMaxAverage(arr) {
    let totalNumbers = arr.length;
    let min = arr[0];
    let max = arr[0];
    let sum = 0;

    for (let i = 0; i < arr.length; i++) {
        if (arr[i] < min) {
            min = arr[i];
        }
        if (arr[i] > max) {
            max = arr[i];
        }
        sum += arr[i];
    }

    let average = sum / totalNumbers;

    console.log("Total Numbers: " + totalNumbers +
        ", Min Value: " + min +
        ", Max Value: " + max +
        ", Average: " + average);
}

// Demonstration
minMaxAverage([15, 5, 23, 42, 3]);
minMaxAverage([1, 9, 15, 41, 19, 32]);
minMaxAverage([27, 18, 25, 11, 29, 31, 45]);


// Exercise #2 - Count Vowels
function countVowels(word) {

    let count = 0;
    word = word.toLowerCase();

    for (let i = 0; i < word.length; i++) {

        if (word[i] === "a" ||
            word[i] === "e" ||
            word[i] === "i" ||
            word[i] === "o" ||
            word[i] === "u") {

            count = count + 1;
        }
    }

    return count;
}

// Demonstration
console.log("Dance:", countVowels("Dance")+ " vowels.");
console.log("Detention:", countVowels("Detention")+ " vowels.");
console.log("Elaborate:", countVowels("Elaborate")+ " vowels.");



// Exercise #3

function sortNumbers(arr) {
    let sortedArray = arr.slice(); // copy array

    sortedArray.sort(function(a, b) {
        return a - b;
    });

    return sortedArray;
}

